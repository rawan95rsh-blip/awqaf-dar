# انسخي هذا الملف إلى .env وضعي القيم الحقيقية — لا ترفعي .env إلى GitHub أبداً
PORT=8000

# MongoDB Atlas (mongodb+srv) — أو الصيغة القياسية إذا فشل DNS
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/awqaf-dar?retryWrites=true&w=majority

# سر عشوائي طويل: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# development: يُرجع كود التحقق في الاستجابة لتسهيل التجربة — لا تستخدميه في الإنتاج
NODE_ENV=development
DEV_VERIFICATION_CODE=7890

# توقيت المراكز بالدقائق (الكويت = 180)
CENTER_TZ_OFFSET_MINUTES=180

# إرسال كود التحقق برسالة SMS (مطلوب في الإنتاج) — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

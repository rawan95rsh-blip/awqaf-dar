PORT=8000
# استخدمي mongodb+srv من Atlas، أو الصيغة القياسية إذا فشل DNS (ESERVFAIL):
# MONGODB_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/awqaf-dar?ssl=true&authSource=admin&replicaSet=REPLICA_SET&appName=awqaf-dar1
MONGODB_URI=mongodb+srv://USER:PASSWORD@awqaf-dar1.md0ppjw.mongodb.net/awqaf-dar?appName=awqaf-dar1
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
NODE_ENV=development
DEV_VERIFICATION_CODE=7890

# —— إنتاج (أسبوع 10) ——
# NODE_ENV=production
# لا تضعي DEV_VERIFICATION_CODE في الإنتاج
# JWT_SECRET يجب أن يكون عشوائياً طويلاً وغير مُلتزَم في Git
# انشري عبر HTTPS فقط (Render / Railway / VPS خلف reverse proxy)
# EXPO_PUBLIC_API_URL على الموبايل = https://your-api.example.com (بدون شرطة أخيرة)

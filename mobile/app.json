{
  "expo": {
    "name": "دور القرآن",
    "slug": "awqaf-dar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "awqafdar",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F3EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kw.awqaf.darquran",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "لإشعارات قبول التسجيل واعتذار المعلمة عن الحصة",
        "NSFaceIDUsageDescription": "لفتح التطبيق ببصمة الوجه دون إدخال كلمة المرور",
        "NSCameraUsageDescription": "لتصوير البطاقة المدنية والمؤهل الدراسي عند التسجيل",
        "NSPhotoLibraryUsageDescription": "لاختيار صور المرفقات (البطاقة المدنية، الصورة الشخصية، المؤهل)",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "kw.awqaf.darquran",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0E5E4E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0E5E4E"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "لفتح التطبيق ببصمة الوجه دون إدخال كلمة المرور"
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "لاختيار صور المرفقات (البطاقة المدنية، الصورة الشخصية، المؤهل)",
          "cameraPermission": "لتصوير البطاقة المدنية والمؤهل الدراسي عند التسجيل"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "e8bb9308-72f5-4285-b970-6ae217a5fc5b"
      },
      "supportsRTL": true,
      "forcesRTL": true
    },
    "owner": "rawan.alshatri",
    "locales": {
      "ar": "./locales/ar.json"
    }
  }
}
